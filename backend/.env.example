# 可选：不填也能跑（导航/找物品/按键全是本地模型），
# 只是没有语音输入(ASR)和大模型闲聊
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型（qwen-omni-turbo 已下线）
QWEN_OMNI_MODEL=qwen3.5-omni-flash
QWEN_OMNI_FALLBACKS=qwen3.5-omni-plus,qwen3-omni-flash
# 文本模型（物品名翻译用）
QWEN_MODEL=qwen-turbo

# ---- 无 ESP32 模式：手机摄像头 + 电脑麦克风 + 电脑喇叭 ----
PC_IO=1
PHONE_CAM_URL=http://172.20.10.2:4747/video
PHONE_CAM_FPS=15
PC_CAMERA=1
PC_PTT=0
PC_KEYS=0
PC_MIC=1
PC_SPEAKER=1
